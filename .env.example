# Copy to .env to run locally (`npm run dev`). On ZeroTo, add these in the deployment's Variables tab
# with "Used by: Build" (a website's values are fixed while it is BUILT), then redeploy.
VITE_SITE_NAME=ZeroTo UI test
# The zeroto-test-app deployment this site talks to (no trailing slash). Leave empty to see the setup hint.
VITE_API_URL=http://localhost:3000
